# Template for local setup: copy to `.env.local` and fill in the values.
# `.env.example` is committed on purpose and must never hold a real secret.

# Resend API key used by /api/contact to deliver the contact form.
# Create one at https://resend.com/api-keys with "Sending access" only.
# Until a domain is verified with Resend, mail can only be sent to the address
# the Resend account itself was registered with.
RESEND_API_KEY=
